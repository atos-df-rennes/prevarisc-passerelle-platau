{
    "name": "sdis62/prevarisc-passerelle-platau",
    "type": "application",
    "description": "Une passerelle d'import / export automatisée entre Prevarisc et Plat'AU",
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.0",
        "kamermans/guzzle-oauth2-subscriber": "^1.0",
        "uma/dic": "^1.0",
        "symfony/console": "^5.2",
        "doctrine/dbal": "^3.0",
        "league/flysystem": "^2.0",
        "symfony/options-resolver": "^5.2",
        "pagerfanta/pagerfanta": "^3.6",
        "caseyamcl/guzzle_retry_middleware": "^2.8",
        "adbario/php-dot-notation": "^3.2",
        "symfony/serializer": "^5.4",
        "symfony/property-info": "^5.4",
        "symfony/property-access": "^5.4",
        "phpdocumentor/reflection-docblock": "^5.6"
    },
    "require-dev": {
        "kdubuc/php-cs-fixer-rules": "^1.0",
        "vimeo/psalm": "^6.0",
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpunit/phpunit": "^10.5",
        "rector/rector": "^2.5"
    },
    "scripts": {
        "analyse": "vendor/bin/psalm",
        "test": "vendor/bin/phpunit --testdox tests/",
        "refactor": "vendor/bin/rector",
        "cs": "vendor/bin/php-cs-fixer fix --config=vendor/kdubuc/php-cs-fixer-rules/php-cs-fixer.php"
    },
    "license": "CeCILL-B",
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/platau"
    ]
}
